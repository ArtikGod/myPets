{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "psychology-bot-telegram",
  "version": "1.0.0",
  "description": "Telegram бот для психолог-помощника",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean"
  },
  "dependencies": {
    "telegraf": "^4.15.6",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "telegram",
    "bot",
    "psychology",
    "mental-health",
    "typescript",
    "nodejs"
  ],
  "author": "Psychology Bot Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/psychology-bot-telegram.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/psychology-bot-telegram/issues"
  },
  "homepage": "https://github.com/your-username/psychology-bot-telegram#readme"
}