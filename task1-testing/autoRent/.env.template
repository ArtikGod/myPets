# База данных MongoDB
# Строка подключения к MongoDB
DB_CONNECTION_STRING=mongodb://localhost:27017/auto

# Настройки сервера
# Порт, на котором будет запущен сервер
PORT=3200

# Настройки Telegram бота (опционально)
# Токен бота, полученный от @BotFather
TG_BOT_TOKEN=your_telegram_bot_token_here

# ID администраторов в Telegram (через запятую)
ADMIN_TG_IDS=your_telegram_id_here

# ID администратора в базе данных (MongoDB ObjectId)
ADMIN_DB_USER_ID=your_mongodb_admin_user_id_here

# Настройки окружения
# Режим работы приложения (development, production, test)
NODE_ENV=development

# Настройки логирования
# Уровень логирования (error, warn, info, debug)
LOG_LEVEL=info

# Настройки CORS (опционально)
# Разрешенные домены для CORS
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3200

# Настройки безопасности (опционально)
# Секретный ключ для JWT (если будет использоваться)
# JWT_SECRET=your_jwt_secret_here

# Настройки производительности (опционально)
# Максимальное количество подключений к БД
# DB_MAX_POOL_SIZE=10

# Таймаут подключения к БД (в миллисекундах)
# DB_SERVER_SELECTION_TIMEOUT=5000

# Таймаут сокета БД (в миллисекундах)
# DB_SOCKET_TIMEOUT=45000