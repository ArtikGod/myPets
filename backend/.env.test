# Тестовая база данных
DATABASE_URL="postgresql://postgres:password@localhost:5432/psychology_bot_test"

# JWT секретный ключ для тестов
JWT_SECRET_KEY="test-jwt-secret-key-for-psychology-bot"

# Настройки приложения
NODE_ENV="test"
BACKEND_PORT="3001"

# CORS настройки
CORS_ORIGIN="http://localhost:3000"

# Rate limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="1000"

# Планировщик задач
DAILY_TASK_TIME="09:00"
TIMEZONE="Europe/Moscow"
SCHEDULER_ENABLED="false"

# Отключаем внешние сервисы в тестах
TELEGRAM_BOT_TOKEN=""
EMAIL_HOST=""
OPENAI_API_KEY="sk-test-key-for-mocking-ai-service-in-tests-1234567890abcdef"