{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest", "supertest"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": [
    "src/**/*",
    "src/tests/**/*",
    "src/types/**/*"
  ],
  "exclude": []
}